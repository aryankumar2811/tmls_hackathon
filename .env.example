# ─── LLMs ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ORCHESTRATOR_MODEL=claude-sonnet-4-6     # supervisor + Correlation agent
AGENT_MODEL=claude-haiku-4-5             # fast specialist agents

# ─── Embeddings ──────────────────────────────────────────────────────────
# RAG currently uses Chroma's built-in on-device MiniLM (no API key needed).
# These keys are wired in config.py for a future embedding-provider upgrade
# but are NOT read by the current ingest/retriever code.
# OPENAI_API_KEY=sk-...                  # text-embedding-3-small (future)
# VOYAGE_API_KEY=                        # voyage-3 (future alternative)
# EMBEDDING_PROVIDER=openai              # openai | voyage (future)

# ─── Tracing ─────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ovenmind

# ─── RAG ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ─── Alerts ──────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Cost guardrails (DO NOT REMOVE — a runaway supervisor can burn credits) ─
MAX_SUPERVISOR_TURNS=8
MAX_TOKENS_PER_AGENT=4000

# ─── Demo replay ─────────────────────────────────────────────────────────
REPLAY_SPEED=3.0        # NOTE: currently unused — runner.py uses fixed delays for replay pacing
USE_RUN_CACHE=true      # cache the first real agent run per scenario; replay after

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
